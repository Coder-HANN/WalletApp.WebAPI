{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=WalletApplicationDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "YourSuperSecretKey_ChangeThisToStrongRandomValue123!",
    "Issuer": "WalletAppAPI",
    "Audience": "WalletAppUser"
  },
  "AdminUser": {
    "UserName": "Bedirhan",
    "Email": "admin@walletapp.com",
    "Password": "123456",
    "Role": "Admin"
  },
  "LoggingConfig": {
    "Providers": {
      "Serilog": {
        "Enabled": true,
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Process", "Serilog.Enrichers.Thread" ],
        "MinimumLevel": "Debug",
        "WriteTo": [
          { "Name": "Console" },
          {
            "Name": "MSSqlServer",
            "Args": {
              "connectionString": "Server=localhost\\SQLEXPRESS;Database=WalletApplicationDB;Trusted_Connection=True;TrustServerCertificate=True;",
              "tableName": "Logs",
              "autoCreateSqlTable": true,
              "columnOptionsSection": {
                "removeStandardColumns": [ "Properties" ],
                "disableTriggers": true,
                "additionalColumns": [
                  {
                    "ColumnName": "Source",
                    "DataType": "nvarchar",
                    "DataLength": 256,
                    "AllowNull": true
                  },
                  {
                    "ColumnName": "UserId",
                    "DataType": "int",
                    "AllowNull": true
                  },
                  {
                    "ColumnName": "RequestPath",
                    "DataType": "nvarchar",
                    "DataLength": 512,
                    "AllowNull": true
                  },
                  {
                    "ColumnName": "RequestBody",
                    "DataType": "nvarchar",
                    "DataLength": -1,
                    "AllowNull": true
                  },
                  {
                    "ColumnName": "ResponseBody",
                    "DataType": "nvarchar",
                    "DataLength": -1,
                    "AllowNull": true
                  },
                  {
                    "ColumnName": "StatusCode",
                    "DataType": "int",
                    "AllowNull": true
                  },
                  {
                    "ColumnName": "IpAddress",
                    "DataType": "nvarchar",
                    "DataLength": 64,
                    "AllowNull": true
                  },
                  {
                    "ColumnName": "MachineName",
                    "DataType": "nvarchar",
                    "DataLength": 128,
                    "AllowNull": true
                  },
                  {
                    "ColumnName": "RequestTime",
                    "DataType": "datetime",
                    "AllowNull": false
                  },
                  {
                    "ColumnName": "DurationMs",
                    "DataType": "bigint",
                    "AllowNull": true
                  }
                ]
              }
            }
          }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
      }
    },
    "NLog": { "Enabled": false }
  }
}

    
    
  
    
  

